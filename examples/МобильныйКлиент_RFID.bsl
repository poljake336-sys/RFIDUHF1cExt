/////////////////////////////////////////////////////////////////////////////////////////////////////
//
// Пример клиентского модуля формы МП 1С для компоненты RFIDUHF.
//
// Автор: Каюмов А.Р.
// Дата:  02.10.2026
// использовать НачатьПодключениеВнешнейКомпоненты.
//
/////////////////////////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Перем RFID;

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты", ЭтотОбъект);
	НачатьПодключениеВнешнейКомпоненты(
		Оповещение,
		"ОбщийМакет.RFIDUHF",
		"RFID",
		ТипВнешнейКомпоненты.Native);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияКомпоненты(Подключено, ДополнительныеПараметры) Экспорт

	Если Не Подключено Тогда
		Сообщить("Компонента RFIDUHF не подключена (проверьте макет RFIDUHF.zip)");
		Возврат;
	КонецЕсли;

	RFID = Новый("AddIn.RFID.RFIDUHF");

	Если Не RFID.Инициализировать() Тогда
		Сообщить("Ошибка инициализации UHF: " + RFID.ПоследняяОшибка);
		Возврат;
	КонецЕсли;

	// Для узкой зоны полки начинать с 10 - 15 dBm
	RFID.УстановитьМощность(15);
	Сообщить("UHF готов: " + RFID.ОписаниеУстройства);

КонецПроцедуры

&НаКлиенте
Процедура НачатьСканирование(Команда)

	Если RFID = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не RFID.НачатьИнвентаризацию() Тогда
		Сообщить(RFID.ПоследняяОшибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьСканирование(Команда)

	Если RFID <> Неопределено Тогда
		RFID.ОстановитьИнвентаризацию();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)

	Если Источник <> "org.rfiduhf.addin" Тогда
		Возврат;
	КонецЕсли;

	Если Событие = "TagRead" Тогда
		// Данные — JSON: {"epc":"...","tid":"...","rssi":"...","ts":...}
		Сообщить(Данные);
	ИначеЕсли Событие = "Error" Тогда
		Сообщить("RFID: " + Данные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	// Без Завершить() модуль UHF на C72 часто зависает до перезагрузки ТСД.
	Если RFID <> Неопределено Тогда
		RFID.ОстановитьИнвентаризацию();
		RFID.Завершить();
		RFID = Неопределено;
	КонецЕсли;

КонецПроцедуры
