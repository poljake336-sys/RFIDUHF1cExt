&НаКлиенте
Перем RFID;

&НаКлиенте
Перем СчётчикОК;

&НаКлиенте
Перем СчётчикОшибки;

&НаКлиенте
Перем СчётчикПредупреждения;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Мощность = 15;
	Статус = "Подключение компоненты...";
	ИтогПроверки = "";
	СканированиеАктивно = Ложь;
	RFID = Неопределено;

	Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты", ЭтотОбъект);
	НачатьПодключениеВнешнейКомпоненты(
		Оповещение,
		"ОбщийМакет.RFIDUHF",
		"RFID",
		ТипВнешнейКомпоненты.Native);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодключенияКомпоненты(Подключено, ДополнительныеПараметры) Экспорт

	Если Не Подключено Тогда
		Пояснение = ПояснениеОшибкиПодключения();
		Статус = "Компонента НЕ подключена. " + Пояснение;
		ИтогПроверки = "FAIL: AddIn не загружен";
		ДобавитьВЖурнал(Статус);
		Возврат;
	КонецЕсли;

	Попытка
		RFID = Новый("AddIn.RFID.RFIDUHF");
	Исключение
		Статус = "Ошибка создания AddIn.RFID.RFIDUHF: " + ОписаниеОшибки();
		ИтогПроверки = "FAIL: объект AddIn";
		ДобавитьВЖурнал(Статус);
		RFID = Неопределено;
		Возврат;
	КонецПопытки;

	Статус = "Компонента загружена. Нажмите «Полная проверка API»";
	ИтогПроверки = "AddIn OK — жду проверки";
	ДобавитьВЖурнал(Статус);

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если RFID <> Неопределено Тогда
		Попытка
			RFID.ОстановитьИнвентаризацию();
			RFID.Завершить();
		Исключение
		КонецПопытки;
		RFID = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)

	Если Источник <> "org.rfiduhf.addin" Тогда
		Возврат;
	КонецЕсли;

	Если Событие = "TagRead" Тогда
		ДобавитьМеткуИзJSON(Данные);
	ИначеЕсли Событие = "Error" Тогда
		ДобавитьВЖурнал("RFID Error: " + Данные);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Команды

&НаКлиенте
Процедура ПолнаяПроверка(Команда)

	РезультатыПроверки.Очистить();
	СчётчикОК = 0;
	СчётчикОшибки = 0;
	СчётчикПредупреждения = 0;
	ИтогПроверки = "Идёт проверка...";
	Статус = "Полная проверка API...";
	ДобавитьВЖурнал("=== Полная проверка API RFIDUHF ===");

	Если RFID = Неопределено Тогда
		ЗафиксироватьШаг("Объект AddIn", Ложь, "ERR", "RFID = Неопределено — сначала дождитесь подключения");
		ЗавершитьПроверку();
		Возврат;
	КонецЕсли;

	ЗафиксироватьШаг("Объект AddIn.RFID.RFIDUHF", Истина, "OK", "Создан");

	// --- Свойства до init (должны читаться без падения) ---
	ПроверитьЧтениеОписаниеУстройства();
	ПроверитьЧтениеПодключено();
	ПроверитьЧтениеИнвентаризацияАктивна();
	ПроверитьЧтениеМощность();
	ПроверитьЧтениеПоследняяОшибка();

	// --- Инициализировать ---
	ОкInit = Ложь;
	Попытка
		ОкInit = RFID.Инициализировать();
	Исключение
		ЗафиксироватьШаг("Инициализировать()", Ложь, "ERR", ОписаниеОшибки());
		ЗавершитьПроверку();
		Возврат;
	КонецПопытки;

	Если ОкInit Тогда
		ЗафиксироватьШаг("Инициализировать()", Истина, "OK", "true | " + Строка(RFID.ОписаниеУстройства));
	Иначе
		ЗафиксироватьШаг("Инициализировать()", Ложь, "ERR",
			"false | " + Строка(RFID.ПоследняяОшибка)
			+ " (на эмуляторе/телефоне без C72 UHF — ожидаемо)");
		ЗавершитьПроверку();
		Возврат;
	КонецЕсли;

	Если RFID.Подключено Тогда
		ЗафиксироватьШаг("Свойство Подключено", Истина, "OK", "Истина после init");
	Иначе
		ЗафиксироватьШаг("Свойство Подключено", Ложь, "ERR", "Ложь после успешного init");
	КонецЕсли;

	// --- Мощность методом ---
	Целевая = 15;
	ОкPower = Ложь;
	Попытка
		ОкPower = RFID.УстановитьМощность(Целевая);
	Исключение
		ЗафиксироватьШаг("УстановитьМощность(15)", Ложь, "ERR", ОписаниеОшибки());
		ОкPower = Ложь;
	КонецПопытки;

	Если ОкPower Тогда
		Прочитано = RFID.Мощность;
		Если Прочитано = Целевая Тогда
			ЗафиксироватьШаг("УстановитьМощность(15)+чтение", Истина, "OK", "Мощность=" + Формат(Прочитано, "ЧГ=0"));
		Иначе
			ЗафиксироватьШаг("УстановитьМощность(15)+чтение", Ложь, "WARN",
				"set OK, но getPower=" + Формат(Прочитано, "ЧГ=0"));
		КонецЕсли;
	Иначе
		ЗафиксироватьШаг("УстановитьМощность(15)", Ложь, "ERR", Строка(RFID.ПоследняяОшибка));
	КонецЕсли;

	Мощность = Целевая;

	// --- Мощность свойством ---
	Попытка
		RFID.Мощность = 16;
		Если RFID.Мощность = 16 Тогда
			ЗафиксироватьШаг("Свойство Мощность=16", Истина, "OK", "запись/чтение свойства");
		Иначе
			ЗафиксироватьШаг("Свойство Мощность=16", Ложь, "WARN",
				"записали 16, прочитали " + Формат(RFID.Мощность, "ЧГ=0"));
		КонецЕсли;
		RFID.УстановитьМощность(15);
		Мощность = 15;
	Исключение
		ЗафиксироватьШаг("Свойство Мощность", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

	// --- Частотный режим (мягкая проверка: метод вызывается) ---
	Попытка
		ОкFreq = RFID.УстановитьЧастотныйРежим(1);
		Если ОкFreq Тогда
			ЗафиксироватьШаг("УстановитьЧастотныйРежим(1)", Истина, "OK", "true");
		Иначе
			ЗафиксироватьШаг("УстановитьЧастотныйРежим(1)", Ложь, "WARN",
				"false | " + Строка(RFID.ПоследняяОшибка) + " (режим может отличаться по региону)");
		КонецЕсли;
	Исключение
		ЗафиксироватьШаг("УстановитьЧастотныйРежим(1)", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

	// --- Inventory start/stop ---
	ОкStart = Ложь;
	Попытка
		ОкStart = RFID.НачатьИнвентаризацию();
	Исключение
		ЗафиксироватьШаг("НачатьИнвентаризацию()", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

	Если ОкStart Тогда
		Если RFID.ИнвентаризацияАктивна Тогда
			ЗафиксироватьШаг("НачатьИнвентаризацию()+флаг", Истина, "OK", "ИнвентаризацияАктивна=Истина");
		Иначе
			ЗафиксироватьШаг("НачатьИнвентаризацию()+флаг", Ложь, "WARN",
				"start true, но ИнвентаризацияАктивна=Ложь");
		КонецЕсли;
	Иначе
		ЗафиксироватьШаг("НачатьИнвентаризацию()", Ложь, "ERR", Строка(RFID.ПоследняяОшибка));
	КонецЕсли;

	ОкStop = Ложь;
	Попытка
		ОкStop = RFID.ОстановитьИнвентаризацию();
	Исключение
		ЗафиксироватьШаг("ОстановитьИнвентаризацию()", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

	Если ОкStop Тогда
		Если Не RFID.ИнвентаризацияАктивна Тогда
			ЗафиксироватьШаг("ОстановитьИнвентаризацию()+флаг", Истина, "OK", "ИнвентаризацияАктивна=Ложь");
		Иначе
			ЗафиксироватьШаг("ОстановитьИнвентаризацию()+флаг", Ложь, "WARN",
				"stop true, но флаг ещё Истина");
		КонецЕсли;
	Иначе
		ЗафиксироватьШаг("ОстановитьИнвентаризацию()", Ложь, "ERR", Строка(RFID.ПоследняяОшибка));
	КонецЕсли;

	СканированиеАктивно = Ложь;

	// --- Одна метка (без метки в поле = WARN, не ERR) ---
	Попытка
		ОкSingle = RFID.СчитатьОднуМетку();
		Если ОкSingle Тогда
			ЗафиксироватьШаг("СчитатьОднуМетку()", Истина, "OK",
				"метка поймана — смотрите таблицу/журнал TagRead");
		Иначе
			ЗафиксироватьШаг("СчитатьОднуМетку()", Ложь, "WARN",
				"false | " + Строка(RFID.ПоследняяОшибка)
				+ " — поднесите метку и нажмите «1 метка»");
		КонецЕсли;
	Исключение
		ЗафиксироватьШаг("СчитатьОднуМетку()", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

	// --- Завершить + повторный init (жизненный цикл) ---
	Попытка
		ОкDown = RFID.Завершить();
		Если ОкDown Тогда
			ЗафиксироватьШаг("Завершить()", Истина, "OK", "true");
		Иначе
			ЗафиксироватьШаг("Завершить()", Ложь, "ERR", Строка(RFID.ПоследняяОшибка));
		КонецЕсли;
	Исключение
		ЗафиксироватьШаг("Завершить()", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

	Попытка
		ОкRe = RFID.Инициализировать();
		Если ОкRe Тогда
			RFID.УстановитьМощность(15);
			ЗафиксироватьШаг("Повторный Инициализировать()", Истина, "OK", "цикл shutdown→init OK");
		Иначе
			ЗафиксироватьШаг("Повторный Инициализировать()", Ложь, "ERR", Строка(RFID.ПоследняяОшибка));
		КонецЕсли;
	Исключение
		ЗафиксироватьШаг("Повторный Инициализировать()", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

	ЗавершитьПроверку();

КонецПроцедуры

&НаКлиенте
Процедура НачатьСканирование(Команда)

	Если Не УбедитьсяUHF() Тогда
		Возврат;
	КонецЕсли;

	Если Не RFID.НачатьИнвентаризацию() Тогда
		ДобавитьВЖурнал(RFID.ПоследняяОшибка);
		Возврат;
	КонецЕсли;

	СканированиеАктивно = Истина;
	Статус = "Сканирование...";
	ДобавитьВЖурнал("Старт инвентаризации");

КонецПроцедуры

&НаКлиенте
Процедура ОстановитьСканирование(Команда)

	Если RFID = Неопределено Тогда
		Возврат;
	КонецЕсли;

	RFID.ОстановитьИнвентаризацию();
	СканированиеАктивно = Ложь;
	Статус = "Остановлено. Меток: " + Формат(Метки.Количество(), "ЧГ=0");
	ДобавитьВЖурнал(Статус);

КонецПроцедуры

&НаКлиенте
Процедура СчитатьОдну(Команда)

	Если Не УбедитьсяUHF() Тогда
		Возврат;
	КонецЕсли;

	Если RFID.СчитатьОднуМетку() Тогда
		ДобавитьВЖурнал("СчитатьОднуМетку: OK (ждём TagRead)");
	Иначе
		ДобавитьВЖурнал("СчитатьОднуМетку: " + RFID.ПоследняяОшибка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьМетки(Команда)

	Метки.Очистить();
	ДобавитьВЖурнал("Список меток очищен");

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьМощность(Команда)

	Если Не УбедитьсяUHF() Тогда
		Возврат;
	КонецЕсли;

	Если Мощность < 5 Или Мощность > 30 Тогда
		ДобавитьВЖурнал("Мощность должна быть 5..30 dBm");
		Возврат;
	КонецЕсли;

	Если Не RFID.УстановитьМощность(Мощность) Тогда
		ДобавитьВЖурнал("Не удалось установить мощность: " + RFID.ПоследняяОшибка);
		Возврат;
	КонецЕсли;

	ДобавитьВЖурнал("Мощность: " + Формат(Мощность, "ЧГ=0") + " dBm (read="
		+ Формат(RFID.Мощность, "ЧГ=0") + ")");

КонецПроцедуры

#КонецОбласти

#Область Служебные

&НаКлиенте
Функция ПояснениеОшибкиПодключения()

	СистИнфо = Новый СистемнаяИнформация;
	Платформа = Строка(СистИнфо.ТипПлатформы);
	ВерсияОС = Строка(СистИнфо.ВерсияОС);

	// В zip только Android (.so + apk). На Windows/iOS клиенте подключение всегда false.
	Текст = "ОС=" + ВерсияОС + "; платформа=" + Платформа + ".";

	Если СтрНайти(ВРег(Платформа), "WINDOWS") > 0
		Или СтрНайти(ВРег(ВерсияОС), "WINDOWS") > 0 Тогда
		Текст = Текст
			+ " Это Windows-клиент: RFIDUHF только для Android (C72 / эмулятор Android)."
			+ " Соберите МП и установите на ТСД.";
	Иначе
		Текст = Текст
			+ " Проверьте: макет ОбщийМакет.RFIDUHF = RFIDUHF.zip,"
			+ " архитектура устройства (ARM64/ARM/x86) есть в манифесте.";
	КонецЕсли;

	Возврат Текст;

КонецФункции

&НаКлиенте
Функция УбедитьсяUHF()

	Если RFID = Неопределено Тогда
		ДобавитьВЖурнал("UHF не загружен");
		Возврат Ложь;
	КонецЕсли;

	Если Не RFID.Подключено Тогда
		Если Не RFID.Инициализировать() Тогда
			ДобавитьВЖурнал("Init: " + RFID.ПоследняяОшибка);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ПроверитьЧтениеОписаниеУстройства()

	Попытка
		ЗафиксироватьШаг("Чтение .ОписаниеУстройства", Истина, "OK", Строка(RFID.ОписаниеУстройства));
	Исключение
		ЗафиксироватьШаг("Чтение .ОписаниеУстройства", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЧтениеПодключено()

	Попытка
		ЗафиксироватьШаг("Чтение .Подключено", Истина, "OK", Строка(RFID.Подключено));
	Исключение
		ЗафиксироватьШаг("Чтение .Подключено", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЧтениеИнвентаризацияАктивна()

	Попытка
		ЗафиксироватьШаг("Чтение .ИнвентаризацияАктивна", Истина, "OK", Строка(RFID.ИнвентаризацияАктивна));
	Исключение
		ЗафиксироватьШаг("Чтение .ИнвентаризацияАктивна", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЧтениеМощность()

	Попытка
		ЗафиксироватьШаг("Чтение .Мощность", Истина, "OK", Формат(RFID.Мощность, "ЧГ=0"));
	Исключение
		ЗафиксироватьШаг("Чтение .Мощность", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЧтениеПоследняяОшибка()

	Попытка
		ЗафиксироватьШаг("Чтение .ПоследняяОшибка", Истина, "OK", Строка(RFID.ПоследняяОшибка));
	Исключение
		ЗафиксироватьШаг("Чтение .ПоследняяОшибка", Ложь, "ERR", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗафиксироватьШаг(Шаг, ОК, Уровень, Сообщение)

	Стр = РезультатыПроверки.Добавить();
	Стр.Шаг = Шаг;
	Стр.ОК = ОК;
	Стр.Уровень = Уровень;
	Стр.Сообщение = Сообщение;

	Если Уровень = "OK" Тогда
		СчётчикОК = СчётчикОК + 1;
	ИначеЕсли Уровень = "WARN" Тогда
		СчётчикПредупреждения = СчётчикПредупреждения + 1;
	Иначе
		СчётчикОшибки = СчётчикОшибки + 1;
	КонецЕсли;

	ДобавитьВЖурнал(Уровень + " | " + Шаг + " | " + Сообщение);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПроверку()

	ИтогПроверки = "OK: " + Формат(СчётчикОК, "ЧГ=0")
		+ " | WARN: " + Формат(СчётчикПредупреждения, "ЧГ=0")
		+ " | ERR: " + Формат(СчётчикОшибки, "ЧГ=0");

	Если СчётчикОшибки = 0 Тогда
		Статус = "Проверка завершена — критичных ошибок нет";
	Иначе
		Статус = "Проверка завершена — есть ERR (см. таблицу)";
	КонецЕсли;

	ДобавитьВЖурнал("=== Итог: " + ИтогПроверки + " ===");

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьМеткуИзJSON(ДанныеJSON)

	EPC = ИзвлечьJSON(ДанныеJSON, "epc");
	Если ПустаяСтрока(EPC) Тогда
		ДобавитьВЖурнал("TagRead без epc: " + ДанныеJSON);
		Возврат;
	КонецЕсли;

	Для Каждого Стр Из Метки Цикл
		Если Стр.EPC = EPC Тогда
			Стр.RSSI = ИзвлечьJSON(ДанныеJSON, "rssi");
			Стр.TID = ИзвлечьJSON(ДанныеJSON, "tid");
			Стр.Время = Формат(ТекущаяДата(), "ДЛФ=T");
			Статус = "Меток: " + Формат(Метки.Количество(), "ЧГ=0") + " | last " + EPC;
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Нов = Метки.Добавить();
	Нов.EPC = EPC;
	Нов.TID = ИзвлечьJSON(ДанныеJSON, "tid");
	Нов.RSSI = ИзвлечьJSON(ДанныеJSON, "rssi");
	Нов.Время = Формат(ТекущаяДата(), "ДЛФ=T");

	Статус = "Меток: " + Формат(Метки.Количество(), "ЧГ=0") + " | " + EPC;
	ДобавитьВЖурнал("EPC " + EPC + " RSSI " + Нов.RSSI);

КонецПроцедуры

&НаКлиенте
Функция ИзвлечьJSON(Текст, Ключ)

	Маркер = """" + Ключ + """";
	Поз = СтрНайти(Текст, Маркер);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;

	ПозДвоеточие = СтрНайти(Текст, ":", , Поз);
	Если ПозДвоеточие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Остаток = СокрЛП(Сред(Текст, ПозДвоеточие + 1));
	Если СтрНачинаетсяС(Остаток, """") Тогда
		Остаток = Сред(Остаток, 2);
		Кон = СтрНайти(Остаток, """");
		Если Кон = 0 Тогда
			Возврат Остаток;
		КонецЕсли;
		Возврат Лев(Остаток, Кон - 1);
	КонецЕсли;

	Кон = СтрДлина(Остаток);
	Для Индекс = 1 По СтрДлина(Остаток) Цикл
		Символ = Сред(Остаток, Индекс, 1);
		Если Символ = "," Или Символ = "}" Тогда
			Кон = Индекс - 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат СокрЛП(Лев(Остаток, Кон));

КонецФункции

&НаКлиенте
Процедура ДобавитьВЖурнал(Текст)

	Строка = Формат(ТекущаяДата(), "ДЛФ=T") + "  " + Текст;
	Если ПустаяСтрока(Журнал) Тогда
		Журнал = Строка;
	Иначе
		Журнал = Строка + Символы.ПС + Журнал;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
